# Template for local development. Copy to .env and fill in, or just run
#   vercel env pull .env.local
# which writes every value below straight from the Vercel project.

# Neon Postgres, provisioned through the Vercel Marketplace.
# DATABASE_URL is the pooled connection used by the running app.
# DATABASE_URL_UNPOOLED is the direct connection used by Prisma migrations.
DATABASE_URL="postgres://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Signs the auth JWT (src/controllers/user.controller.ts,
# src/middlewares/auth.middleware.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="generate-your-own"

# Browser origins allowed to call this API directly, comma-separated.
# The deployed frontend proxies /api/* to this backend, so those calls are
# same-origin; this matters for local dev and direct API access.
CORS_ORIGIN="http://localhost:5173"
