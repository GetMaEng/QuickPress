{
  "name": "quickpress-backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/dev-server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "vercel-build": "prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.10",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
